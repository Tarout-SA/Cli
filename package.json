{
	"name": "@tarout/cli",
	"version": "1.12.0",
	"description": "Tarout CLI — the Saudi cloud platform for coding agents",
	"type": "module",
	"bin": {
		"tarout": "./bin/tarout",
		"tarout-mcp": "./bin/tarout-mcp"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"bin",
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts src/mcp/stdio.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts src/mcp/stdio.ts --format esm --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"test": "vitest run && bun test",
		"test:vitest": "vitest run",
		"test:bun": "bun test",
		"test:watch": "vitest",
		"start": "node dist/index.js",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@trpc/client": "^10.45.4",
		"@trpc/server": "^10.45.4",
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"commander": "^12.1.0",
		"conf": "^13.1.0",
		"express": "^4.22.3",
		"inquirer": "^12.11.1",
		"open": "^10.2.0",
		"ora": "^8.2.0",
		"superjson": "^2.2.6",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@types/express": "^4.17.25",
		"@types/node": "^22.20.4",
		"@types/ws": "^8.18.1",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"body-parser": "1.20.6",
		"@hono/node-server": "1.19.17",
		"hono": "4.13.8",
		"fast-uri": "3.1.8",
		"ip-address": "10.7.2",
		"postcss": "8.5.28",
		"qs": "6.16.0",
		"esbuild": "0.28.1",
		"vite": "6.4.3"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tarout-SA/cli.git"
	},
	"bugs": {
		"url": "https://github.com/Tarout-SA/cli/issues"
	},
	"homepage": "https://tarout.sa",
	"keywords": [
		"tarout",
		"paas",
		"cloud",
		"deployment",
		"cli"
	],
	"author": "Tarout",
	"license": "MIT"
}
